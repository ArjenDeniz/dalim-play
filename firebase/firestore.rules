rules_version = '2';

// Film Kapışması live rooms. The host screen owns a room; phones join it as players
// and drop one answer per question. Everyone is signed in anonymously.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{pin} {
      function room() {
        return get(/databases/$(database)/documents/rooms/$(pin)).data;
      }
      function isHost() {
        return request.auth != null && room().hostUid == request.auth.uid;
      }

      // phones look a room up by its PIN before joining
      allow read: if request.auth != null;
      // a PIN already taken by another host fails here (that write is an update), and the host picks a new one
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && pin.matches('[0-9]{4}');
      allow update, delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      match /players/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 16;
        allow delete: if request.auth != null && (request.auth.uid == uid || isHost());
      }

      // id is `${round}_${uid}`, so a second tap in the same round is an update and gets refused.
      // Answers count only while the options are lit, measured on the server clock.
      match /answers/{answerId} {
        allow read: if request.auth != null && (isHost() || resource.data.uid == request.auth.uid);
        allow delete: if isHost();
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'round', 'choice', 'at'])
          && request.resource.data.uid == request.auth.uid
          && answerId == string(request.resource.data.round) + '_' + request.auth.uid
          && request.resource.data.choice is int
          && request.resource.data.choice >= 0
          && request.resource.data.choice <= 3
          && request.resource.data.at == request.time
          && exists(/databases/$(database)/documents/rooms/$(pin)/players/$(request.auth.uid))
          && room().phase == 'answering'
          && request.resource.data.round == room().round
          && request.time <= room().openedAt + duration.value(room().limitMs, 'ms');
      }
    }
  }
}
